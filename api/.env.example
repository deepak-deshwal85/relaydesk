# Embeddings
OPENAI_API_KEY=

# PostgreSQL — Neon (SSL required). Use the asyncpg driver form below.
# Example: postgresql+asyncpg://USER:PASSWORD@HOST/neondb
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-odd-mode-b3q1m3t1-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb

# Qdrant Cloud (required for local and production API)
QDRANT_CLUSTER_ENDPOINT=https://your-cluster.aws.cloud.qdrant.io
QDRANT_CLUSTER_NAME=
QDRANT_API_KEY=

# RAG API server
RAG_API_HOST=0.0.0.0
RAG_API_PORT=8090

# OAuth2 (AWS Cognito). Set OAUTH_DISABLED=true for local API without JWT validation.
OAUTH_DISABLED=true
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_UI_CLIENT_ID=
COGNITO_M2M_CLIENT_ID=
COGNITO_REQUIRED_SCOPE=relaydesk-api/access

# Outbound calls via LiveKit SIP
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
# SIP hostname from LiveKit project settings, without sip: prefix.
# Example: vjnxecm0tjk.sip.livekit.cloud
LIVEKIT_SIP_HOST=
LIVEKIT_AGENT_NAME=relaydesk-agent

# Plivo number purchase and per-user SIP trunks.
# India numbers often require KYC in the Plivo console before purchase succeeds.
# India calling also requires LiveKit region pinning.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_NUMBER_COUNTRY=IN
PLIVO_NUMBER_TYPE=local

# Optional
# RAG_BACKEND=qdrant
# RAG_MAX_RESULTS=5
# RAG_MIN_SCORE=0.3
# CORS_ORIGINS=http://localhost:3000
