# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Voice pipeline (STT → LLM → TTS)
# STT: AssemblyAI streaming English (~$0.0025/min). Override: universal-3-5-pro
ASSEMBLYAI_API_KEY=
STT_MODEL=universal-streaming-english

# LLM: DeepSeek V4 Flash (OpenAI-compatible)
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# TTS: Deepgram Aura-2 (same DEEPGRAM_API_KEY)
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-andromeda-en

CALCOM_API_KEY=

# Agent identity
AGENT_NAME=relaydesk-agent
CLIENT_PHONE_OVERRIDE=+911171366880

# RAG — call the API service
RAG_BACKEND=qdrant
# RAG API URL when using qdrant backend (local dev). In AWS ECS use Cloud Map: http://api.relaydesk.local:8090
RAG_API_BASE_URL=http://127.0.0.1:8090

# Cognito M2M (client credentials) — used when production API requires OAuth
COGNITO_TOKEN_URL=https://relaydesk-prod.auth.ap-south-1.amazoncognito.com/oauth2/token
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_SCOPE=relaydesk-api/access
