# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Voice pipeline provider: legacy (default) or sarvam
VOICE_PROVIDER=legacy

# Sarvam — STT + LLM + TTS (single API key). Set VOICE_PROVIDER=sarvam to enable.
# https://docs.sarvam.ai/integrations/livekit
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_LANGUAGE=en-IN
SARVAM_STT_MODE=transcribe
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_SPEAKER=shubh
SARVAM_LLM_MODEL=sarvam-30b

# Legacy provider (VOICE_PROVIDER=legacy) — AssemblyAI + DeepSeek + Deepgram
ASSEMBLYAI_API_KEY=
# Universal-3.5-Pro Realtime (aliases: u3-rt-pro, universal-3.5-pro-realtime)
STT_MODEL=universal-3-5-pro
DEEPSEEK_API_KEY=
# Off-peak pricing is automatic (50% off outside peak UTC windows); same model ID.
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPGRAM_API_KEY=
# Aura-1 voices: aura-asteria-en, aura-luna-en, aura-stella-en, …
DEEPGRAM_TTS_MODEL=aura-asteria-en

CALCOM_API_KEY=

# Agent identity
AGENT_NAME=relaydesk-agent
CLIENT_PHONE_OVERRIDE=+911171366880

# RAG — call the API service
RAG_BACKEND=qdrant
RAG_API_BASE_URL=http://127.0.0.1:8090

# Cognito M2M (client credentials) — used when production API requires OAuth
COGNITO_TOKEN_URL=https://relaydesk-prod.auth.ap-south-1.amazoncognito.com/oauth2/token
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_SCOPE=relaydesk-api/access
